{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    // Left off deliberately: the codebase is written against the standard
    // optional-property semantics (it passes `undefined` freely to `?:`
    // fields from parsed query params and form data throughout). Enabling
    // exactOptionalPropertyTypes would require ~30 mechanical `| undefined`
    // widenings that only re-express that same intent. All other strict
    // flags (strict, noUncheckedIndexedAccess, noImplicitOverride) stay on.
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "declaration": false,
    "noEmit": true
  }
}
