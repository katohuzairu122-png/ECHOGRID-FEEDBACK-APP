# Used only by drizzle-kit (schema generation/migrations) and seed scripts
# (db:seed, db:seed:platform-admin), all of which run as plain Node CLIs
# outside the Workers runtime and can't use the Hyperdrive binding. The
# deployed Worker never reads this file -- runtime secrets are in .dev.vars
# (see .dev.vars.example), not here. Point this at the same Neon database as
# the Hyperdrive connection string configured via `wrangler hyperdrive create`.
DATABASE_URL=postgresql://<user>:<password>@<neon-host>/<db>?sslmode=require

# Platform Admin Console (db:seed:platform-admin) -- bootstraps the first
# account that can log into the console. Run once per environment, then this
# account can grant platformRole to others through the console UI itself
# (Block 5+); these env vars don't need to stay set afterward. Use a real
# password manager-generated value for PLATFORM_ADMIN_PASSWORD, not a
# placeholder, even in staging -- this account can access every business's
# data.
PLATFORM_ADMIN_EMAIL=admin@yourcompany.example
PLATFORM_ADMIN_PASSWORD=replace-with-a-strong-random-value
PLATFORM_ADMIN_NAME=Platform Admin
