{
  "name": "@echo-grid-feedback/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed/permissions.seed.ts",
    "db:seed:platform-admin": "tsx src/db/seed/platform-admin.seed.ts",
    "db:seed:billing-backfill": "tsx src/db/seed/billing-permissions-backfill.seed.ts",
    "db:seed:plans": "tsx src/db/seed/subscription-plans.seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:workers": "vitest run --config vitest.workers.config.ts"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "zod": "^4.4.3",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.16.3",
    "stripe": "^22.2.1",
    "@echo-grid-feedback/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2",
    "wrangler": "^4.108.0",
    "drizzle-kit": "^0.31.10",
    "dotenv": "^17.4.2",
    "tsx": "^4.19.0",
    "vitest": "^3.1.3",
    "@cloudflare/vitest-pool-workers": "^0.9.5"
  }
}
