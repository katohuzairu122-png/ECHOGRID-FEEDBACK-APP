# Server-only: the Hono API's base URL. Deliberately NOT prefixed with
# NEXT_PUBLIC_ -- the browser never calls the API directly. Next.js Server
# Actions and Server Components (Branch Mgmt Block 3's BFF pattern) call
# this server-to-server and set httpOnly session cookies on the response;
# access/refresh tokens never reach browser-side JS. If a genuine
# client-side call to the API is ever needed later, add a separate
# NEXT_PUBLIC_ var rather than exposing this one.
API_BASE_URL=http://localhost:8787
